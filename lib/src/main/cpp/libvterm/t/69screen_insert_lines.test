INIT
WANTSTATE
WANTSCREEN
RESIZE 4,10

!Insertion follows the cursor line and preserves its column
RESET
PUSH "A\r\nBC"
INSERT_LINES 1,2
  scrolled 0
  ?cursor = 3,2
  ?screen_row 0 = "A"
  ?screen_row 1 = ""
  ?screen_row 2 = ""
  ?screen_row 3 = "BC"

!Insertion at the bottom scrolls old lines into history
WANTSCREEN b
INSERT_LINES 3,2
  sb_pushline 10 = 41
  sb_pushline 10 =
  scrolled 2
  ?cursor = 3,2
  ?screen_row 3 = "BC"
WANTSCREEN -b

!Insertion below the cursor does not move it
RESET
PUSH "ABC"
INSERT_LINES 2,1
  scrolled 0
  ?cursor = 0,3
  ?screen_row 0 = "ABC"

!Invalid arguments and zero count leave the screen unchanged
INSERT_LINES -1,1
  scrolled -1
INSERT_LINES 4,1
  scrolled -1
INSERT_LINES 0,-1
  scrolled -1
INSERT_LINES 0,0
  scrolled 0
  ?cursor = 0,3
  ?screen_row 0 = "ABC"

!Insertion ignores application scrolling margins
RESET
PUSH "\e[2;3r\e[4;1HQ"
INSERT_LINES 0,2
  scrolled 2
  ?cursor = 3,1
  ?screen_row 3 = "Q"

!Single-row screens keep a valid cursor
RESIZE 1,10
RESET
PUSH "ABC"
INSERT_LINES 0,1
  scrolled 1
  ?cursor = 0,3
  ?screen_row 0 = ""
